# Vercel → Project → Settings → Environment Variables дээр оруулна.

# Cloudflare D1 (бодит өгөгдлийн сан)
# Cloudflare dashboard → баруун талын "Account ID"
CF_ACCOUNT_ID=
# domch өгөгдлийн сангийн ID
CF_D1_DATABASE_ID=0e1a2ad5-1dc0-4fb3-9429-e84fb3a5fa2e
# My Profile → API Tokens → Create Token → Custom: Account · D1 · Edit
CF_API_TOKEN=

# /admin хэсэгт нэвтрэх түлхүүр (урт, санамсаргүй утга сонгоно)
ADMIN_TOKEN=

# Заавал биш: зочдын IP-г hash хийх давс (хүсэлтийн давтамж хязгаарлахад)
IP_HASH_SALT=

# Компьютер дээр D1-гүйгээр ажиллуулах (npm run dev:api үүнийг өөрөө тохируулна)
# LOCAL_DB_PATH=.local/domch.db
